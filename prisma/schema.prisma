// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  emailVerified DateTime?
  image         String?
  
  profile       Profile?
  sessions      Session[]
  answers       Answer[]
  exams         Exam[]
  studyPlans    StudyPlan[]
  studySessions StudySession[]
  reviews       Review[]
  bookmarks     Bookmark[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// User Profile
model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  goal            String?   // ex: "ENEM 2024", "Vestibular UFRJ"
  mainExam        String?
  examDate        DateTime?
  timePerDay      Int?      // in minutes
  daysPerWeek     Int?
  knowledgeLevel  String?   // "beginner", "intermediate", "advanced"
  totalStudyTime  Int       @default(0) // in minutes
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

// Study Content Structure
model Subject {
  id              String    @id @default(cuid())
  name            String    @unique // ex: "Matemática", "Português"
  slug            String    @unique
  description     String?
  icon            String?
  
  topics          Topic[]
  examSubjects    ExamSubject[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
}

model Topic {
  id              String    @id @default(cuid())
  name            String
  subjectId       String
  slug            String
  description     String?
  
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       Question[]
  studyPlanTopics StudyPlanTopic[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([slug])
}

// Questions
model Question {
  id              String    @id @default(cuid())
  enunciation     String    // Question text
  topicId         String
  difficulty      String    // "easy", "medium", "hard"
  source          String?   // "ENEM", "Fuvest", etc
  year            Int?
  explanation     String?   // Answer explanation
  
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  alternatives    Alternative[]
  answers         Answer[]
  examQuestions   ExamQuestion[]
  bookmarks       Bookmark[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([topicId])
  @@index([difficulty])
  @@index([year])
}

model Alternative {
  id              String    @id @default(cuid())
  questionId      String
  letter          String    // "A", "B", "C", etc
  text            String
  isCorrect       Boolean   @default(false)
  
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@unique([questionId, letter])
  @@index([questionId])
}

// User Answers
model Answer {
  id              String    @id @default(cuid())
  userId          String
  questionId      String
  selectedAnswer  String?   // letter of selected alternative
  isCorrect       Boolean?
  timeSpent       Int?      // in seconds
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@unique([userId, questionId, createdAt])
  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

// Exams (Simulated tests)
model Exam {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  totalQuestions  Int
  duration        Int?      // in minutes
  passPercentage  Int       @default(60)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       ExamQuestion[]
  results         ExamResult?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([userId])
  @@index([createdAt])
}

model ExamSubject {
  id              String    @id @default(cuid())
  examId          String
  subjectId       String
  
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  @@unique([examId, subjectId])
}

model ExamQuestion {
  id              String    @id @default(cuid())
  examId          String
  questionId      String
  order           Int       // question order in exam
  
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([examId, questionId])
  @@index([examId])
}

model ExamResult {
  id              String    @id @default(cuid())
  examId          String    @unique
  totalQuestions  Int
  correctAnswers  Int
  wrongAnswers    Int
  percentage      Float
  timeTaken       Int?      // in minutes
  
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@index([examId])
}

// Study Plans
model StudyPlan {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  goal            String?
  targetDate      DateTime
  status          String    @default("active") // "active", "paused", "completed"
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics          StudyPlanTopic[]
  sessions        StudySession[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model StudyPlanTopic {
  id              String    @id @default(cuid())
  studyPlanId     String
  topicId         String
  priority        Int       @default(1) // 1 = high, 2 = medium, 3 = low
  estimatedHours  Int?
  completed       Boolean   @default(false)
  
  studyPlan       StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@unique([studyPlanId, topicId])
  @@index([studyPlanId])
  @@index([completed])
}

// Study Sessions
model StudySession {
  id              String    @id @default(cuid())
  userId          String
  studyPlanId     String
  topicId         String
  duration        Int       // in minutes
  questionsAnswered Int?
  correctAnswers  Int?
  notes           String?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlan       StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([studyPlanId])
  @@index([createdAt])
}

// Performance Tracking
model Progress {
  id              String    @id @default(cuid())
  userId          String
  topicId         String
  totalQuestions  Int       @default(0)
  correctAnswers  Int       @default(0)
  wrongAnswers    Int       @default(0)
  accuracy        Float?
  lastAnsweredAt  DateTime?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([accuracy])
}

// Review System
model Review {
  id              String    @id @default(cuid())
  userId          String
  topicId         String
  priority        Int       @default(1)
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  reviewCount     Int       @default(0)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([nextReviewAt])
}

// Bookmarks
model Bookmark {
  id              String    @id @default(cuid())
  userId          String
  questionId      String
  notes           String?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}
